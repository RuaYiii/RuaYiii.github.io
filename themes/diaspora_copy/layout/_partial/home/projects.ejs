<%
var projects = site.data.projects || [];
%>

<% if (projects.length) { %>
<section class="home-section projects-section" aria-labelledby="projects-title">
    <div class="home-section__inner projects-section__layout">
        <header class="projects-section__intro">
            <p class="projects-section__eyebrow">[01] PROJECTS</p>

            <h2 id="projects-title">Projects</h2>

            <p class="projects-section__description">
                一些正在生长、偶尔维护，<br>
                也可能突然改变方向的东西。
            </p>
        </header>

        <div class="projects-grid<%= projects.length > 1 ? ' projects-grid--multiple' : '' %>">
            <% projects.forEach(function (project, index) { %>
            <article
                class="project-card<%= project.featured ? ' project-card--featured' : '' %>"
                data-project="<%= project.id %>"
                style="--project-accent: <%= project.accent || '#e75867' %>;"
                aria-labelledby="project-<%= project.id %>-title"
                tabindex="0"
            >
                <header class="project-card__header">
                    <span class="project-card__label">
                        <%= project.featured ? 'Featured' : 'Project' %>
                    </span>

                    <span class="project-card__meta">
                        <%= project.status || 'Project' %>
                        <% if (project.year) { %>
                            · <%= project.year %>
                        <% } %>
                    </span>
                </header>

                <div class="project-card__title-block">
                    <h3 id="project-<%= project.id %>-title">
                        <%= project.name %>
                    </h3>

                    <% if (project.subtitle) { %>
                    <p class="project-card__subtitle"><%= project.subtitle %></p>
                    <% } %>
                </div>

                <p class="project-card__description"><%= project.description %></p>

                <% if (project.stack && project.stack.length) { %>
                <ul class="project-card__stack" aria-label="Technology stack">
                    <% project.stack.forEach(function (technology) { %>
                    <li><%= technology %></li>
                    <% }); %>
                </ul>
                <% } %>

                <div class="project-card__mark project-card__mark--<%= project.mark_style || 'monogram' %>" aria-hidden="true">
                    <% if (project.mark_image) { %>
                    <img
                        class="project-card__mark-image"
                        src="<%= url_for(project.mark_image) %>"
                        width="240"
                        height="260"
                        alt=""
                        decoding="async"
                        draggable="false"
                    >
                    <% } else { %>
                    <strong><%= project.monogram || 'PR' %></strong>
                    <span class="project-card__mark-index">
                        <%= String(index + 1).padStart(2, '0') %>
                    </span>
                    <% } %>
                </div>

                <footer class="project-card__actions">
                    <% if (project.live_url) { %>
                    <a
                        href="<%= project.live_url %>"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        打开项目 <span aria-hidden="true">↗</span>
                    </a>
                    <% } %>

                    <% if (project.repository_url) { %>
                    <a
                        href="<%= project.repository_url %>"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        查看源码 <span aria-hidden="true">↗</span>
                    </a>
                    <% } %>
                </footer>
            </article>
            <% }); %>
        </div>
    </div>
</section>
<% } %>
